# Replace this with a descriptive SEC-compliant User-Agent value.
SEC_USER_AGENT=Your Name your.email@example.com

# OpenRouter API key used by the researcher agent's LLMs.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional LangSmith tracing for agent runs (python src/agent_desk/main.py).
# Tracing is on only when LANGSMITH_API_KEY is set; leave it out to run untraced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=agent-desk
